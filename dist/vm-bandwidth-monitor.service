[Unit]
Description=VM bandwidth monitor and rate limiter (eBPF/TC, six selectable algorithms)
Documentation=https://github.com/JamCh01/vm_watcher
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vm-bandwidth-monitor --config /etc/vm-bandwidth-monitor/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
# One fd set per attached TAP (program/map/link fds); large hosts need headroom.
LimitNOFILE=1048576

# Hardening compatible with aya/netlink, the Unix socket and HTTP(S) metrics pushes.
# The daemon still runs as ROOT: it needs CAP_BPF (+ CAP_PERFMON on some kernels) and
# CAP_NET_ADMIN, and BPF capability mode has kernel-version-dependent quirks that are
# NOT yet verified for this program. Switch to the commented capability-based service
# below only after validating it on the target kernel.
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
# /usr and /boot read-only; /run (socket, lock file) stays writable; the legacy pin
# cleanup under /sys/fs/bpf is best-effort and tolerates failure.
ProtectSystem=full
# Everything the daemon opens: Unix socket (IPC), IPv4/IPv6 (metrics), netlink (TC).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Unprivileged mode — NOT validated; enable only after testing on the target kernel:
#   User=vm-bandwidth-monitor
#   Group=vm-bandwidth-monitor
#   AmbientCapabilities=CAP_BPF CAP_NET_ADMIN
#   CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN
# and ensure /sys/fs/bpf and /run/vm-bandwidth-monitor.sock are writable by that user.

[Install]
WantedBy=multi-user.target
