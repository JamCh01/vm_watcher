[Unit]
Description=VM bandwidth monitor and GCRA rate limiter (eBPF/TC)
Documentation=https://github.com/JamCh01/vm_watcher
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vm-bandwidth-monitor --config /etc/vm-bandwidth-monitor/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
# One fd set per attached TAP (program/map/link fds); large hosts need headroom.
LimitNOFILE=1048576
# Needs CAP_BPF (or CAP_SYS_ADMIN on older kernels) + CAP_NET_ADMIN; keep it simple:
# run as root. To run unprivileged, set User=/Group= and use:
#   AmbientCapabilities=CAP_BPF CAP_NET_ADMIN
# and ensure /sys/fs/bpf and /run/vm-bandwidth-monitor.sock are writable by that user.

[Install]
WantedBy=multi-user.target
